generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  STAFF
  HOMEOWNER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  ESCALATED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id                  String             @id @default(cuid())
  email               String             @unique
  password            String
  name                String?
  avatar              String? // Personal avatar for staff members
  role                Role               @default(HOMEOWNER)
  companyId           String?
  company             Company?           @relation(fields: [companyId], references: [id])
  properties          Property[]
  tickets             Ticket[]           @relation("HomeownerTickets")
  knowledgeBaseId     String?
  hasWarrantyAccess   Boolean            @default(true)
  hasSalesAccess      Boolean            @default(false)
  salesPermissions    String[]           @default([])
  lastActiveWorkspace String?            @default("warranty")
  ownedLeads          Lead[]             @relation("LeadOwner")
  agentAppointments   SalesAppointment[] @relation("AgentAppointments")
  contentCalendars    ContentCalendar[]
  warrantyConversations WarrantyConversation[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([companyId])
}

model Company {
  id                      String                  @id @default(cuid())
  name                    String
  logo                    String?
  email                   String?
  phone                   String?
  address                 String?
  warrantyPolicy          String?                 @db.Text
  botColor                String?                 @default("#0F3B3D")
  users                   User[]
  knowledgeBase           KnowledgeBaseDocument[]
  integrations            Integration[]
  communities             Community[]
  leads                   Lead[]
  segments                LeadSegment[]
  salesforceConnection    SalesforceConnection?
  knowledgeBaseId         String?
  defaultLeadOwner        String?
  voiceProfile            String?                 @default("professional")
  salesBrandProfile       Json?
  maxSmsPerHour           Int                     @default(60)
  complianceOptInRequired Boolean                 @default(true)
  smsQuietHoursEnabled    Boolean                 @default(true)
  quietHoursStart         Int                     @default(8)
  quietHoursEnd           Int                     @default(21)
  quietHoursTimezone      String?
  leadStatuses            Json?
  newsSources             Json?
  salesEnabled            Boolean                 @default(false)
  warrantyEnabled         Boolean                 @default(true)
  verificationStatus      String                  @default("PENDING")
  verificationDocUrl      String?
  verificationSubmittedAt DateTime?
  verifiedAt              DateTime?
  automationsKillSwitch   Boolean                 @default(false)
  automationDailyCap      Int                     @default(1000)
  campaignExitConditions  Json?
  campaignVersionPolicy   String                  @default("FINISH_OLD")
  marketingRules          MarketingRule[]
  suppressionList         SuppressionList[]
  campaigns               Campaign[]
  emailTemplates          EmailTemplate[]
  calendarEvents          ContentCalendar[]
  salesKB                 SalesKB[]
  announcements           Announcement[]
  availabilitySetting     AvailabilitySetting?
  calendarConnections     CalendarConnection[]
  scrapedNews             ScrapedNews[]
  blogPosts               BlogPost[]
  csvMappingTemplates     CsvMappingTemplate[]
  csvImportJobs           CsvImportJob[]
  deadLetters             DeadLetter[]
  tickets                 Ticket[]
  properties              Property[]
  appointmentMode         String                  @default("AI")
  agentMaxTurns           Int                     @default(4)
  aiPlatformGrant         String?
  // Set when a tenant admin asks the platform administrator for a platform key.
  // Cleared once a grant is issued, so the request state is never stale.
  aiPlatformKeyRequestedAt DateTime?
  aiPlatformKeyRequestedBy String?
  warrantyKBs             WarrantyKB[]
  warrantyConversations   WarrantyConversation[]
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
}

model CsvMappingTemplate {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  mapping   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
}

model CsvImportJob {
  id            String    @id @default(cuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId        String?
  status        String    @default("QUEUED")
  mergeStrategy String    @default("update")
  totalRows     Int       @default(0)
  processedRows Int       @default(0)
  createdCount  Int       @default(0)
  updatedCount  Int       @default(0)
  skippedCount  Int       @default(0)
  errorCount    Int       @default(0)
  rows          Json
  errors        Json?
  startedAt     DateTime?
  completedAt   DateTime?
  failedAt      DateTime?
  errorMessage  String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([companyId, status, createdAt])
  @@index([companyId, createdAt])
}

model Integration {
  id          String  @id @default(cuid())
  companyId   String
  company     Company @relation(fields: [companyId], references: [id])
  platform    String
  apiKey      String?
  secretKey   String?
  environment String  @default("production")
  isActive    Boolean @default(true)
  smtpHost    String?
  smtpPort    Int?
  senderEmail String?
  senderName  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

model Property {
  id           String    @id @default(cuid())
  address      String
  city         String?
  state        String?
  zipCode      String?
  areaOfHome   String?
  coeDate      DateTime?
  coverageTerm DateTime?
  homeownerId  String
  homeowner    User      @relation(fields: [homeownerId], references: [id])
  companyId    String?
  company      Company?  @relation(fields: [companyId], references: [id])
  /// Which community this home is in. Null when it has not been assigned to one.
  communityId  String?
  community    Community? @relation(fields: [communityId], references: [id], onDelete: SetNull)
  tickets      Ticket[]
  warrantyConversations WarrantyConversation[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([homeownerId])
  @@index([companyId])
}

model Ticket {
  id             String         @id @default(cuid())
  issueType      String
  ticketType     String?
  description    String?        @db.Text
  status         TicketStatus   @default(OPEN)
  priority       TicketPriority @default(MEDIUM)
  isEmergency    Boolean        @default(false)
  warrantyYear   Int            @default(1)
  erpSyncStatus  String?        @default("PENDING")
  erpReferenceId String?
  draftResponse  String?        @db.Text
  chatSummary    String?        @db.Text
  extractedInfo  String?        @db.Text
  kbReferences   String?        @db.Text
  homeownerId    String
  homeowner      User           @relation("HomeownerTickets", fields: [homeownerId], references: [id])
  propertyId     String?
  property       Property?      @relation(fields: [propertyId], references: [id])
  companyId      String?
  company        Company?       @relation(fields: [companyId], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([homeownerId])
  @@index([propertyId])
  @@index([companyId, status])
  @@index([status])
}

model Community {
  id          String                  @id @default(cuid())
  companyId   String
  company     Company                 @relation(fields: [companyId], references: [id])
  name        String
  color       String                  @default("#0F3B3D")
  documents   KnowledgeBaseDocument[]
  warrantyKBs WarrantyKB[]
  properties  Property[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([companyId])
}

model KnowledgeBaseDocument {
  id          String     @id @default(cuid())
  companyId   String
  company     Company    @relation(fields: [companyId], references: [id])
  communityId String?
  community   Community? @relation(fields: [communityId], references: [id], onDelete: SetNull)
  name        String
  size        String
  url         String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([companyId])
  @@index([communityId])
}

/// Which tier a knowledge-base document belongs to.
/// PLATFORM rows are shared across every company; COMPANY rows belong to one.
enum KBScope {
  PLATFORM
  COMPANY
}

enum LeadSource {
  SALESFORCE
  CSV
  MANUAL
}

model Lead {
  id                      String                   @id @default(cuid())
  companyId               String
  company                 Company                  @relation(fields: [companyId], references: [id])
  source                  LeadSource               @default(MANUAL)
  externalId              String?
  firstName               String
  lastName                String
  email                   String?
  phone                   String?
  street                  String?
  city                    String?
  state                   String?
  zipCode                 String?
  status                  String                   @default("New")
  bookingToken            String?                  @unique
  ownerId                 String?
  owner                   User?                    @relation("LeadOwner", fields: [ownerId], references: [id])
  tags                    String[]                 @default([])
  emailOptIn              Boolean                  @default(false)
  smsOptIn                Boolean                  @default(false)
  consentSource           String?
  consentTimestamp        DateTime?
  customFields            Json?
  archived                Boolean                  @default(false)
  archivedAt              DateTime?
  appointments            SalesAppointment[]
  campaignEnrollments     CampaignEnrollment[]
  schedulingConversations SchedulingConversation[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  @@index([companyId, status])
  @@index([companyId, email])
  @@index([companyId, phone])
  @@index([ownerId])
  @@index([companyId, archived])
}

model LeadSegment {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  filters   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

model SalesAppointment {
  id              String    @id @default(cuid())
  leadId          String
  lead            Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  title           String
  time            DateTime
  endTime         DateTime?
  durationMinutes Int       @default(30)
  status          String    @default("CONFIRMED")
  locationType    String    @default("VIRTUAL")
  meetingLink     String?
  googleEventId   String?
  notes           String?   @db.Text
  leadTimezone    String?
  bookedVia       String    @default("STAFF")
  rescheduleToken String    @unique @default(uuid())
  cancelToken     String    @unique @default(uuid())
  reminder24Sent  Boolean   @default(false)
  reminder1Sent   Boolean   @default(false)
  agentId         String
  agent           User      @relation("AgentAppointments", fields: [agentId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([agentId, time])
  @@index([leadId])
  @@index([status, time])
}

model SalesforceConnection {
  id               String    @id @default(cuid())
  companyId        String    @unique
  company          Company   @relation(fields: [companyId], references: [id])
  instanceUrl      String
  accessToken      String    @db.Text
  refreshToken     String    @db.Text
  tokenExpiresAt   DateTime
  environment      String    @default("sandbox")
  clientId         String
  clientSecret     String    @db.Text
  syncInterval     Int       @default(15)
  isActive         Boolean   @default(true)
  lastSyncAt       DateTime?
  lastSyncStatus   String?
  lastSyncMessage  String?   @db.Text
  writeBackEnabled Boolean   @default(false)
  lastWriteBackAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model SyncLog {
  id          String   @id @default(cuid())
  companyId   String
  direction   String
  action      String
  status      String
  recordCount Int      @default(0)
  errorCount  Int      @default(0)
  message     String?  @db.Text
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([companyId, createdAt])
}

model SalesforceFieldMapping {
  id              String   @id @default(cuid())
  companyId       String
  salesforceField String
  portalField     String
  description     String?
  isActive        Boolean  @default(true)
  isConsentField  Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([companyId, salesforceField])
}

model SalesforceMappingVersion {
  id          String   @id @default(cuid())
  companyId   String
  version     Int
  mappings    Json
  changeType  String
  note        String?
  createdById String?
  createdAt   DateTime @default(now())

  @@unique([companyId, version])
  @@index([companyId, createdAt])
}

model SalesConfigVersion {
  id          String   @id @default(cuid())
  companyId   String
  version     Int
  snapshot    Json
  changeType  String
  note        String?
  createdById String?
  createdAt   DateTime @default(now())

  @@unique([companyId, version])
  @@index([companyId, createdAt])
}

model DeadLetter {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  source    String
  channel   String
  leadId    String?
  refId     String?
  payload   Json
  error     String  @db.Text
  attempts  Int     @default(1)
  status    String  @default("PENDING")

  replayedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([companyId, status, createdAt])
  @@index([companyId, refId])
}

model SuppressionList {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  value     String
  reason    String
  createdAt DateTime @default(now())

  @@unique([companyId, value])
}

enum StepType {
  EMAIL
  SMS
  DELAY
}

model Campaign {
  id              String               @id @default(cuid())
  companyId       String
  company         Company              @relation(fields: [companyId], references: [id])
  name            String
  description     String?
  status          String               @default("Draft")
  channel         String               @default("Email & SMS")
  appointmentMode String               @default("INHERIT")
  agentMaxTurns   Int?
  exitConditions  Json?
  versionPolicy   String               @default("FINISH_OLD")
  steps           CampaignStep[]
  enrollments     CampaignEnrollment[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([companyId, status])
}

model CampaignStep {
  id              String         @id @default(cuid())
  campaignId      String
  campaign        Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  type            StepType
  position        Int
  delayValue      Int?
  delayUnit       String?
  sendWindowDays  String?
  sendWindowStart String?
  sendWindowEnd   String?
  subject         String?
  body            String?
  templateId      String?
  template        EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([campaignId])
}

model CampaignEnrollment {
  id                  String    @id @default(cuid())
  leadId              String
  lead                Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campaignId          String
  campaign            Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  status              String    @default("ACTIVE")
  exitedReason        String?
  currentStepPosition Int       @default(0)
  nextRunAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([leadId, campaignId])
  @@index([status, nextRunAt])
  @@index([campaignId, status])
}

model EmailTemplate {
  id        String         @id @default(cuid())
  companyId String
  company   Company        @relation(fields: [companyId], references: [id])
  name      String
  subject   String
  body      String         @db.Text
  variables String[]       @default([])
  steps     CampaignStep[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([companyId])
}

model ContentCalendar {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  title         String
  channel       String
  scheduledAt   DateTime
  status        String   @default("Draft")
  content       String   @db.Text
  subject       String?
  reason        String?  @db.Text
  outline       String?
  isAiSuggested Boolean  @default(false)
  ownerId       String?
  owner         User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([companyId, scheduledAt])
  @@index([status, scheduledAt])
}

/// Two tiers, distinguished by `scope`:
///   PLATFORM — shared by every company. The base knowledge the agent works from.
///              companyId is null; uploaded by super-admins from the Prompt Lab.
///   COMPANY  — that one company's own policies, layered on top of the platform tier.
/// Retrieval returns both, ranked together. See services/vector-store.service.js.
model SalesKB {
  id         String         @id @default(cuid())
  scope      KBScope        @default(COMPANY)
  companyId  String?
  company    Company?       @relation(fields: [companyId], references: [id])
  name       String
  size       String
  url        String
  category   String         @default("General")
  status     String         @default("PENDING")
  chunkCount Int            @default(0)
  error      String?        @db.Text
  isDeleted  Boolean        @default(false)
  deletedAt  DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  chunks     SalesKBChunk[]

  @@index([companyId, isDeleted])
  @@index([scope, isDeleted])
}

model SalesKBChunk {
  id         String                      @id @default(cuid())
  /// Denormalised from the parent document so retrieval filters without a join.
  scope      KBScope                     @default(COMPANY)
  companyId  String?
  documentId String
  document   SalesKB                     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunkIndex Int
  name       String
  category   String                      @default("General")
  content    String                      @db.Text
  embedding  Unsupported("vector(384)")?
  createdAt  DateTime                    @default(now())

  @@index([companyId])
  @@index([scope])
  @@index([documentId])
}

model MarketingRule {
  id              String             @id @default(cuid())
  companyId       String
  company         Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name            String
  description     String?            @db.Text
  triggerEvent    String
  conditions      Json               @default("[]")
  actions         Json               @default("[]")
  isActive        Boolean            @default(false)
  cooldownHours   Int                @default(24)
  rateLimitCount  Int                @default(0)
  rateLimitWindow String             @default("DAY")
  runCount        Int                @default(0)
  lastTriggeredAt DateTime?
  createdById     String?
  runs            MarketingRuleRun[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([companyId, triggerEvent, isActive])
}

// SW-AMK-005: audit log — one row per rule evaluation.
model MarketingRuleRun {
  id           String        @id @default(cuid())
  ruleId       String
  rule         MarketingRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  companyId    String
  leadId       String?
  triggerEvent String
  matched      Boolean       @default(false)
  actionsTaken Json?
  outcome      String?
  createdAt    DateTime      @default(now())

  @@index([ruleId, leadId, createdAt])
  @@index([companyId, createdAt])
}

model Announcement {
  id            String    @id @default(cuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title         String
  subject       String
  body          String    @db.Text
  ctaLink       String?
  channel       String    @default("EMAIL")
  audienceType  String    @default("ALL")
  segmentId     String?
  geoFilter     Json?
  status        String    @default("Draft")
  scheduledAt   DateTime?
  sentAt        DateTime?
  audienceCount Int       @default(0)
  // Outcome of the last send, so the UI can show what actually happened rather
  // than assuming everyone in the audience received it.
  sentCount     Int       @default(0)
  failedCount   Int       @default(0)
  skippedCount  Int       @default(0)
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([companyId])
}

enum CalendarProvider {
  GOOGLE
}

model AvailabilitySetting {
  id               String   @id @default(cuid())
  companyId        String   @unique
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  dayStart         String   @default("09:00")
  dayEnd           String   @default("17:00")
  bufferMinutes    Int      @default(15)
  slotDuration     Int      @default(30)
  workingDays      String   @default("Mon,Tue,Wed,Thu,Fri")
  timezone         String   @default("America/New_York")
  appointmentTypes Json?
  reminderHours    Int[]    @default([24, 1])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model CalendarConnection {
  id             String           @id @default(cuid())
  companyId      String
  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  provider       CalendarProvider
  accessToken    String           @db.Text
  refreshToken   String?          @db.Text
  tokenExpiresAt DateTime?
  scope          String?          @db.Text
  accountEmail   String?
  calendarId     String           @default("primary")
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([companyId, provider])
}

model SchedulingConversation {
  id           String   @id @default(cuid())
  leadId       String
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  channel      String
  mode         String   @default("AI")
  status       String   @default("ACTIVE")
  turnCount    Int      @default(0)
  transcript   Json     @default("[]")
  offeredSlots Json?
  campaignId   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([leadId])
}

model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  companyId  String?
  actorId    String?
  actorEmail String?
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([action, createdAt])
}

enum BlogStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  PUBLISHED
}

model BlogPost {
  id              String     @id @default(cuid())
  companyId       String
  company         Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title           String
  slug            String?
  excerpt         String?    @db.Text
  content         String     @db.Text
  category        String     @default("Market Trends")
  tags            String[]   @default([])
  status          BlogStatus @default(DRAFT)
  aiAssisted      Boolean    @default(false)
  metaTitle       String?
  metaDescription String?    @db.Text
  headings        String[]   @default([])
  tone            String?
  targetAudience  String?
  citations       Json?
  kbCitations     Json?
  sourceNewsIds   String[]   @default([])
  approvedAt      DateTime?
  approvedById    String?
  publishedAt     DateTime?
  calendarEventId String?
  authorId        String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([companyId, slug])
  @@index([companyId, status])
  @@index([companyId, publishedAt])
}

model ScrapedNews {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title       String
  originalUrl String
  summary     String   @db.Text
  source      String   @default("Google News RSS")
  imageUrl    String?
  publishedAt DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId, publishedAt])
}

model SalesAgentAppointment {
  id            String   @id @default(cuid())
  name          String
  email         String
  phone         String
  preferredTime String
  status        String   @default("CONFIRMED")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SalesAgentPromptVersion {
  id              String   @id @default(cuid())
  label           String?
  systemTemplate  String   @db.Text
  toolDescription String   @db.Text
  kbEmptyText     String   @db.Text
  notes           String?  @db.Text
  // A Prompt Lab bookmark: the draft the lab reopens. Affects nothing else.
  isActive        Boolean  @default(false)
  // The prompt real leads are talking to. Set only by the audited "Set Live"
  // action, never by saving. At most one row may have this true.
  isLive          Boolean  @default(false)
  setLiveAt       DateTime?
  setLiveById     String?
  setLiveByName   String?
  createdById     String?
  createdByName   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isActive])
  @@index([isLive])
  @@index([createdAt])
}

/// Same two-tier arrangement as SalesKB — see the comment on that model.
model WarrantyKB {
  id         String              @id @default(cuid())
  scope      KBScope             @default(COMPANY)
  companyId  String?
  company    Company?            @relation(fields: [companyId], references: [id])
  /// Null means shared across every community. Set means it applies only to that one.
  communityId String?
  community   Community?         @relation(fields: [communityId], references: [id], onDelete: SetNull)
  name       String
  size       String
  url        String
  category   String              @default("General")
  status     String              @default("PENDING")
  error      String?             @db.Text
  chunkCount Int                 @default(0)
  version    Int                 @default(1)
  isActive   Boolean             @default(true)
  createdAt  DateTime            @default(now())
  chunks     WarrantyKBChunk[]

  @@index([companyId, isActive])
  @@index([scope, isActive])
  @@index([communityId])
}

model WarrantyKBChunk {
  id         String                      @id @default(cuid())
  /// Denormalised from the parent document so retrieval filters without a join.
  scope      KBScope                     @default(COMPANY)
  companyId  String?
  /// Mirrors WarrantyKB.communityId. Null means every community.
  communityId String?
  documentId String
  document   WarrantyKB                  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunkIndex Int
  content    String                      @db.Text
  embedding  Unsupported("vector(384)")?
  createdAt  DateTime                    @default(now())

  @@index([companyId])
  @@index([scope])
  @@index([communityId])
  @@index([documentId])
}

model WarrantyConversation {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  homeownerId     String?
  homeowner       User?    @relation(fields: [homeownerId], references: [id])
  propertyId      String?
  property        Property? @relation(fields: [propertyId], references: [id])
  status          String   @default("ACTIVE") // ACTIVE, RESOLVED, ESCALATED
  phase           String   @default("INTAKE") // INTAKE, IDENTIFY, DIAGNOSE, RESOLVE
  issueState      Json?                       // Structured collected data
  ticketId        String?
  transcript      Json     @default("[]")
  turnCount       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([companyId, status])
}
