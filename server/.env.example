# --- App ---
NEXT_PUBLIC_URL=https://portal.example.com
PORT=5000
NODE_ENV=development

# --- Database ---
DATABASE_URL=postgresql://username:password@hostname:5432/database

# --- Supabase (auth + file storage) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- Secrets & encryption ---
APP_ENCRYPTION_KEY=
SESSION_SECRET=
# Shared secret for inbound webhooks that carry no provider signature
# (compliance inbound, unsubscribe, Brevo inbound email). Header only.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRATION_WEBHOOK_SECRET=
# Dedicated secret for the Botpress webhooks. Falls back to SESSION_SECRET if
# unset, but that reuses the session-signing key — set this and rotate.
BOTPRESS_WEBHOOK_SECRET=

# --- Email configuration (SMTP fallback) ---
SENDER_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=


SMS_PROVIDER=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

TELNYX_API_KEY=
# Telnyx number in E.164, or set TELNYX_MESSAGING_PROFILE_ID to send from a number pool.
TELNYX_FROM_NUMBER=
TELNYX_MESSAGING_PROFILE_ID=
# Account Public Key — verifies inbound webhook signatures.
TELNYX_PUBLIC_KEY=

# --- Google Calendar (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- Background jobs (Inngest) ---
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Super admin login ---
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# --- Tenant registration & compliance notifications ---
ADMIN_NOTIFY_EMAIL=
ADMIN_NOTIFY_PHONE=
