# --- App ---
NEXT_PUBLIC_URL=https://portal.example.com
PORT=5000
NODE_ENV=development

# --- Database ---
DATABASE_URL=postgresql://username:password@hostname:5432/database
DATABASE_POOL_MAX=1

# --- Supabase (auth + file storage) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- Secrets & encryption ---
APP_ENCRYPTION_KEY=
SESSION_SECRET=
# How long a signed-in session survives WITHOUT use, in days (default 90).
SESSION_MAX_AGE_DAYS=90
# Shared secret for inbound webhooks that carry no provider signature
INTEGRATION_WEBHOOK_SECRET=

# --- Email configuration (SMTP fallback) ---
SENDER_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=



TELNYX_API_KEY=
# Telnyx number in E.164, or set TELNYX_MESSAGING_PROFILE_ID to send from a number pool.
TELNYX_FROM_NUMBER=
TELNYX_MESSAGING_PROFILE_ID=
# Account Public Key — verifies inbound webhook signatures.
TELNYX_PUBLIC_KEY=

# --- Background jobs (Inngest) ---
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Super admin login ---
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_MFA_DISABLED=1

SUPERADMIN_PHONE=

# --- Warranty agent ---

WARRANTY_SESSION_IDLE_MINUTES=30

# --- AI (platform-owned; every workspace runs on this key) ---
ANTHROPIC_API_KEY=sk-ant-...
# Optional overrides. Defaults: claude-sonnet-5 / claude-haiku-4-5.
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_FAST_MODEL=claude-haiku-4-5

# --- Inbound email (optional) ---
INBOUND_EMAIL_DOMAIN=

# Super Admin / Super Staff personal calendars (Appointments page). Redirect URIs to register:
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# "common" accepts work/school and personal Microsoft accounts.
MICROSOFT_TENANT=common
# Calendly OAuth app (trade scheduling).
CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=
CALENDLY_REDIRECT_URI=
# Webhook signing key from the Calendly app (verifies POST /api/webhooks/calendly).
CALENDLY_WEBHOOK_SIGNING_KEY=

# --- AI4HB website B2B intake ---
WEBSITE_B2B_INTAKE_SECRET=
WEBSITE_PUBLIC_URL=